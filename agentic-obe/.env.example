# ---- Database ----
# Local development: leave empty -> uses ./data/obe.db (Node's built-in SQLite)
# Vercel / production: Supabase Postgres connection string
#   Supabase dashboard -> Connect -> "Transaction pooler" (port 6543)
DATABASE_URL=

# (alternative to Supabase) Turso / libSQL
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- AI (optional) ----
# Leave empty to use the built-in NLP engine. Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
